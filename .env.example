BOT_TOKEN=123456:replace-with-token-from-BotFather
BASE_API_URL=http://localhost:8000
# Public website base URL for "View on site" links (defaults to BASE_API_URL)
SITE_URL=

# Channel that listings are posted to (@channelusername or -100... id). The bot must be an admin.
CHANNEL_ID=@your_channel
CURRENCY=USD
DOWN_PAYMENT_PERCENT=20

# Two bots share one code base and one database (see bot/roles.py).
# Host bot: BOT_ROLE=host, needs RENTER_BOT_USERNAME (for the channel's Book button) and RENTER_BOT_TOKEN.
# Renter bot: BOT_ROLE=renter, needs HOST_BOT_TOKEN. Each bot has its own BOT_TOKEN.
BOT_ROLE=host
RENTER_BOT_USERNAME=
RENTER_BOT_TOKEN=
HOST_BOT_TOKEN=
