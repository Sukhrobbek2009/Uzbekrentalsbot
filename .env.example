BOT_TOKEN=123456:replace-with-token-from-BotFather
BASE_API_URL=http://localhost:8000
# Public website base URL for "View on site" links (defaults to BASE_API_URL)
SITE_URL=

# Channel that listings are posted to (@channelusername or -100... id). The bot must be an admin.
CHANNEL_ID=@your_channel
# Payment provider token from BotFather (Bot Settings > Payments). Use a TEST token while developing.
PAYMENT_PROVIDER_TOKEN=
CURRENCY=USD
DOWN_PAYMENT_PERCENT=20
